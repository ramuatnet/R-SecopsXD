{
  "name": "owasp-assessment-platform",
  "version": "0.1.0",
  "description": "OWASP Top 10:2025 web application vulnerability assessment platform (authorized targets only)",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.ts",
    "cli": "node src/cli/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/unit/**/*.test.ts\" \"test/integration/**/*.test.ts\" \"test/e2e/*.test.ts\"",
    "test:unit": "node --test \"test/unit/**/*.test.ts\"",
    "test:integration": "node --test \"test/integration/**/*.test.ts\"",
    "test:e2e": "node --test \"test/e2e/*.test.ts\"",
    "fixture:vuln": "node fixtures/vuln-app/server.cjs",
    "fixture:clean": "node fixtures/hardened-app/server.cjs",
    "demo": "node scripts/demo.ts",
    "lint:templates": "node scripts/lint-templates.ts",
    "canary": "node scripts/canary-scan.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3"
  }
}
